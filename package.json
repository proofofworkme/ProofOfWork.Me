{
  "name": "proofofwork-me",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "prepare": "node scripts/install-repository-hooks.mjs --if-unset",
    "hooks:install": "node scripts/install-repository-hooks.mjs",
    "hygiene:fix": "node scripts/repository-hygiene.mjs clean",
    "hygiene:check": "node scripts/repository-hygiene.mjs check",
    "hygiene:pre-commit": "node scripts/repository-hygiene.mjs pre-commit",
    "hygiene:test": "node --test scripts/repository-hygiene.test.mjs",
    "check:work-market-v2": "node scripts/check-work-market-v2.mjs",
    "check:work-amo-v5": "node scripts/check-work-amo-v5.mjs",
    "check:work-amo-v5-peak": "node --expose-gc scripts/check-work-amo-v5-peak.mjs",
    "check:work-amo-v5-peak:full": "node --expose-gc scripts/check-work-amo-v5-peak.mjs --full",
    "check:work-amo-v6": "node scripts/check-work-amo-v6.mjs",
    "check:work-amo-v6-peak": "node --expose-gc scripts/check-work-amo-v6-peak.mjs",
    "check:work-amo-v6-peak:full": "node --expose-gc scripts/check-work-amo-v6-peak.mjs --full",
    "build:work-amo-v7-declaration": "node scripts/build-work-amo-v7-declaration.mjs",
    "check:work-amo-v7": "node scripts/check-work-amo-v7.mjs",
    "check:work-amo-v7-peak": "node --expose-gc scripts/check-work-amo-v7-peak.mjs",
    "check:work-amo-v7-peak:full": "node --expose-gc scripts/check-work-amo-v7-peak.mjs --full",
    "build:work-amo-v8-declaration": "node scripts/build-work-amo-v8-declaration.mjs",
    "build:bond-hard-price-declaration": "node scripts/build-bond-hard-price-declaration.mjs",
    "prepare:bond-hard-price-declaration": "node scripts/prepare-bond-hard-price-declaration.mjs",
    "check:work-amo-v8": "node scripts/check-work-amo-v8.mjs && node scripts/check-work-amo-v8-gates.mjs",
    "check:work-amo-v8-peak": "node --expose-gc scripts/check-work-amo-v8-peak.mjs",
    "check:work-amo-v8-peak:full": "node --expose-gc scripts/check-work-amo-v8-peak.mjs --full",
    "migrate:work-market-v2-cutover": "node scripts/migrate-work-market-v2-cutover.mjs",
    "migrate:work-amo-v5": "node scripts/migrate-work-amo-v5.mjs",
    "migrate:work-amo-v6": "node scripts/migrate-work-amo-v6.mjs",
    "migrate:work-precision-v2": "node scripts/migrate-work-precision-v2.mjs",
    "dev": "vite --host 0.0.0.0",
    "dev:prod-api": "vite --host 0.0.0.0 --mode prod-api",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check:ui": "node scripts/check-ui-contract.mjs",
    "check:ui:browser": "playwright test --config playwright.ui.config.mjs",
    "check:hardening": "node scripts/check-hardening-contract.mjs",
    "check:node-ops": "node scripts/check-node-ops-contract.mjs",
    "check:ui-ops": "node scripts/check-ui-ops-contract.mjs",
    "check:api-truth": "node scripts/check-api-truth-contract.mjs",
    "check:canonical-order": "node scripts/check-canonical-order.mjs",
    "check:server-globals": "node scripts/check-server-free-identifiers.mjs",
    "check:electrum-client": "node scripts/check-electrum-client.mjs",
    "check:message-signatures": "node scripts/check-bitcoin-message-signatures.mjs",
    "check:live-data": "node scripts/check-live-data-contract.mjs",
    "check:index-recovery-behavior": "node scripts/check-index-recovery-behavior.mjs",
    "check:client-read-containment": "node scripts/check-client-read-containment.mjs",
    "check:worker-containment": "node scripts/check-worker-containment.mjs",
    "check:send-prep-regressions": "node scripts/check-send-prep-regressions.mjs",
    "check:credit-mint-regressions": "node scripts/check-credit-mint-regressions.mjs",
    "check:marketplace-regressions": "node scripts/check-marketplace-regressions.mjs",
    "check:marketplace-regressions:full": "MARKETPLACE_REGRESSION_MODE=full node scripts/check-marketplace-regressions.mjs",
    "check:mail-regressions": "node scripts/check-mail-regressions.mjs",
    "check:work-participant-regression": "node scripts/check-work-participant-regression.mjs",
    "check:work-precision": "node scripts/check-work-precision-contract.mjs",
    "check:work-precision-v2": "node scripts/check-work-precision-v2.mjs",
    "check:bond-exact-arithmetic": "node scripts/check-bond-exact-arithmetic.mjs",
    "check:incb-range-replay-witness": "node scripts/check-incb-range-replay-witness.mjs",
    "check:incb-oracle-snapshot-restore": "node scripts/check-restore-incb-oracle-snapshots.mjs",
    "db:schema": "node scripts/apply-proof-indexer-schema.mjs",
    "indexer:backfill": "node scripts/backfill-proof-indexer.mjs",
    "indexer:prepare-pwt-range-replay": "node scripts/backfill-proof-indexer.mjs --prepare-canonical-pwt-range-replay",
    "indexer:audit-work-atoms": "node scripts/backfill-proof-indexer.mjs --audit-work-atoms",
    "indexer:audit-work-atoms:repairable": "node scripts/backfill-proof-indexer.mjs --audit-work-atoms --allow-repairable-work-event-precision",
    "indexer:migrate-work-atoms": "node scripts/backfill-proof-indexer.mjs --migrate-work-atoms",
    "indexer:repair-work-atomic-events": "node scripts/backfill-proof-indexer.mjs --repair-work-atomic-events",
    "indexer:restore-incb-oracle-snapshots": "node scripts/restore-incb-oracle-snapshots.mjs",
    "indexer:verify-work-atoms-post-bootstrap": "node scripts/backfill-proof-indexer.mjs --verify-work-atoms-post-bootstrap",
    "indexer:parity": "node scripts/check-proof-indexer-parity.mjs",
    "indexer:worker": "node scripts/run-proof-indexer-worker.mjs",
    "audit:surfaces": "node scripts/audit-production-surfaces.mjs",
    "audit:ledger": "node scripts/audit-ledger-consistency.mjs",
    "audit:computer-events": "node scripts/audit-computer-events.mjs",
    "audit:ids": "node scripts/audit-id-registry.mjs",
    "check:id-address-route": "node scripts/check-id-address-route.mjs",
    "check:id-audit": "node scripts/check-id-registry-audit.mjs",
    "deck:general": "node scripts/build-general-deck.mjs",
    "rank:powids": "node scripts/rank-powid-transactions.mjs",
    "proof-api": "node server/proof-api.mjs"
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "^1.2.0",
    "bitcoinjs-lib": "^7.0.1",
    "buffer": "^6.0.3",
    "lucide-react": "^1.14.0",
    "pg": "^8.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^5.7.2",
    "vite": "^8.1.4"
  }
}
