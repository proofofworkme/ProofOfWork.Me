    "querySha256": "2e60b6935f7ebf1b8314c9f45f6f4f5b7a37f2a1b4ec9bc849252b947047e4c6",
    "sql": "BEGIN READ ONLY; SET LOCAL statement_timeout='5s'; SET LOCAL TIME ZONE 'UTC';\nSELECT coalesce(jsonb_agg(to_jsonb(r)),'[]'::jsonb) FROM (\nSELECT cl.listing_id, cl.seal_txid, canonical_seal_event.seal_event_block_time,\ncanonical_seal_event.seal_event_block_height, canonical_seal_event.seal_event_match_count,\nseal_tx.block_time AS seal_transaction_block_time\nFROM proof_indexer.credit_listings cl\nLEFT JOIN proof_indexer.transactions seal_tx ON seal_tx.network=cl.network AND seal_tx.txid=cl.seal_txid AND seal_tx.status='confirmed'\nLEFT JOIN LATERAL (\n    SELECT\n      canonical_seal_event_row.payload AS seal_event_payload,\n      canonical_seal_event_row.status AS seal_event_status,\n      canonical_seal_event_row.txid AS seal_event_txid,\n      canonical_seal_tx.block_hash AS seal_event_block_hash,\n      canonical_seal_tx.block_time AS seal_event_block_time,\n      canonical_seal_event_row.block_height AS seal_event_block_height,\n      canonical_seal_event_row.block_index AS seal_event_block_index,\n      canonical_seal_event_row.op_return_vout AS seal_event_protocol_vout,\n      canonical_seal_event_row.record_ordinal AS seal_event_record_ordinal,\n      COUNT(*) OVER () AS seal_event_match_count\n    FROM proof_indexer.events canonical_seal_event_row\n    JOIN proof_indexer.transactions canonical_seal_tx\n      ON canonical_seal_tx.network = canonical_seal_event_row.network\n     AND canonical_seal_tx.txid = canonical_seal_event_row.txid\n     AND canonical_seal_tx.status = 'confirmed'\n     AND canonical_seal_tx.block_height =\n       canonical_seal_event_row.block_height\n     AND canonical_seal_tx.block_index =\n       canonical_seal_event_row.block_index\n    JOIN proof_indexer.blocks canonical_seal_block\n      ON canonical_seal_block.network = canonical_seal_tx.network\n     AND canonical_seal_block.block_hash = canonical_seal_tx.block_hash\n     AND canonical_seal_block.height = canonical_seal_tx.block_height\n     AND canonical_seal_block.canonical = true\n    WHERE canonical_seal_event_row.network = cl.network\n      AND canonical_seal_event_row.txid = lower(cl.seal_txid)\n      AND canonical_seal_event_row.valid = true\n      AND canonical_seal_event_row.status = 'confirmed'\n      AND canonical_seal_event_row.protocol = 'pwt1'\n      AND canonical_seal_event_row.kind = 'token-listing-sealed'\n      AND lower(canonical_seal_event_row.payload->>'listingId') =\n        lower(cl.listing_id)\n      AND lower(COALESCE(\n        canonical_seal_event_row.payload->>'tokenId',\n        canonical_seal_event_row.payload->'saleAuthorization'->>'tokenId',\n        ''\n      )) = lower(cl.token_id)\n      AND (\n        lower(COALESCE(cl.token_id, '')) <> 'd4e5ebf11d104d6a63fb74e42094364b25a5f7199a09e5c0e71408972466a8b8'\n        OR (\n          lower(COALESCE(\n            cl.payload->'saleAuthorization'->>'version',\n            ''\n          )) IN (\n            'pwt-sale-v3',\n            'pwt-sale-v4',\n            'pwt-sale-v5',\n            'pwt-sale-v6',\n            'pwt-sale-v8'\n          )\n          AND lower(COALESCE(\n            canonical_seal_event_row.payload->'saleAuthorization'->>'version',\n            ''\n          )) = lower(COALESCE(\n            cl.payload->'saleAuthorization'->>'version',\n            ''\n          ))\n        )\n      )\n    ORDER BY\n      canonical_seal_event_row.block_height DESC,\n      canonical_seal_event_row.block_index DESC,\n      canonical_seal_event_row.op_return_vout DESC,\n      canonical_seal_event_row.record_ordinal DESC\n    LIMIT 1\n  ) canonical_seal_event ON true\nWHERE cl.network='livenet' AND cl.seal_txid=ANY(ARRAY['767b1c7d0df60edc9099ff29269b553843c896e397f550f5d7f8558834575c4b','4f895eaabd46d1c8d69b6ac953aa3776a861bf29951b99a6126b31413b2b15bd','3eb8cfcb5edb187cb77e2bc4ef4a3142a03c4897afe9a800613605e2d65e62e6','00943f5892cee2e9d4d097e9b6098629a7f5a080ccbd7c33b24c8de9685975a5'])\nORDER BY cl.seal_txid) r; ROLLBACK;\n"
  },
