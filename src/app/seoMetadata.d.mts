export type SeoSurface = "landing" | "computer" | "id-launch" | "dns-launch" | "desktop" | "browser" | "pages" | "boost" | "publish" | "search" | "code" | "jobs" | "permission" | "marketplace" | "token" | "wallet" | "work" | "infinity" | "inception" | "log" | "growth";
export type SeoSurfaceMetadata = { surface: SeoSurface; label: string; origin: string; title: string; description: string; heading: string; intro: string };
export type SeoRoute = { kind: "root" | "public-detail" | "private" | "not-found"; canonicalUrl: string | null; robots: string };
export type SeoDocumentVariant = "root" | "app" | "noindex" | "not-found";
export type PageMetadata = SeoRoute & { title: string; description: string; imageUrl: string; imageAlt: string; siteName: string; structuredData: Record<string, unknown>[] };
export const SEO_SURFACES: Readonly<Record<SeoSurface, SeoSurfaceMetadata>>;
export const PUBLIC_SEO_SURFACES: readonly SeoSurfaceMetadata[];
export const SEO_IMAGE_URL: string;
export const SEO_IMAGE_ALT: string;
export const INDEX_ROBOTS: string;
export const NOINDEX_ROBOTS: string;
export const PUBLIC_QUERY_KEYS: Readonly<Record<string, readonly string[]>>;
export const TRACKING_QUERY_PATTERN: RegExp;
export function getSurfaceSeo(surface: string): SeoSurfaceMetadata;
export function isLocalSeoHost(host: string): boolean;
export function resolveSeoSurface(options?: { hostname?: string; env?: Record<string, string | undefined>; search?: string }): SeoSurface;
export function resolveSeoRoute(options: { surface: string; url: string | URL }): SeoRoute;
export function resolvePageMetadata(surface: string, url: string | URL, overrides?: { title?: string; description?: string }): PageMetadata;
export function structuredDataForSurface(surface: string): Record<string, unknown>[];
export function escapeHtml(value: unknown): string;
export function serializeJsonLd(value: unknown): string;
export function renderSeoHead(surface: string, options?: { variant?: SeoDocumentVariant }): string;
export function renderSeoOverview(surface: string): string;
export function renderRobots(surface: string): string;
export function renderSitemap(surface: string): string;
export function resolveDocumentVariant(surface: string, url: string | URL): SeoDocumentVariant;
