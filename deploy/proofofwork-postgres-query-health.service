[Unit]
Description=Check ProofOfWork PostgreSQL query and tablespace health
Requisite=postgresql@16-main.service
After=postgresql@16-main.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/usr/local/sbin/proofofwork-postgres-query-health
Environment=POW_POSTGRES_HEALTH_DATABASE=proof_indexer
Environment=POW_POSTGRES_WARN_QUERY_FANOUT=4
Environment=POW_POSTGRES_CRITICAL_QUERY_FANOUT=8
Environment=POW_POSTGRES_WARN_QUERY_AGE_SECONDS=20
Environment=POW_POSTGRES_CRITICAL_QUERY_AGE_SECONDS=60
Environment=POW_POSTGRES_WARN_CONNECTIONS=70
Environment=POW_POSTGRES_CRITICAL_CONNECTIONS=90
Environment=POW_POSTGRES_WARN_LOCK_WAIT_SECONDS=5
Environment=POW_POSTGRES_CRITICAL_LOCK_WAIT_SECONDS=20
TimeoutStartSec=20s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
