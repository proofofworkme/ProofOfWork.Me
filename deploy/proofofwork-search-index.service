[Unit]
Description=Refresh the additive ProofOfWork Search projection
After=network-online.target postgresql@16-main.service
Requisite=postgresql@16-main.service

[Service]
Type=oneshot
User=powadmin
Group=powadmin
WorkingDirectory=/opt/proofofwork-api
EnvironmentFile=/etc/proofofwork-api/proof-indexer-db.env
EnvironmentFile=-/etc/proofofwork-api/bitcoin-rpc.env
Environment=NETWORK=livenet
Environment=POW_INDEX_DB_POOL_MAX=1
Environment=POW_INDEX_DB_STATEMENT_TIMEOUT_MS=15000
ExecStart=/opt/node-v24.18.0-linux-x64/bin/node /opt/proofofwork-api/scripts/backfill-proof-search.mjs --once --batch-size=200 --max-batches=20 --budget-ms=30000
TimeoutStartSec=45s
TimeoutStopSec=5s
KillMode=control-group
LimitCORE=0
Nice=10
IOSchedulingClass=idle
CPUWeight=25
IOWeight=25
MemoryMax=512M
MemorySwapMax=0
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0027
