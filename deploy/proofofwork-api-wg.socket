[Unit]
Description=ProofOfWork API WireGuard listener
DefaultDependencies=no
Requires=sysinit.target
After=sysinit.target network-online.target wg-quick@wg0.service
Before=shutdown.target
Conflicts=shutdown.target
BindsTo=wg-quick@wg0.service
PartOf=wg-quick@wg0.service

[Socket]
ListenStream=10.77.0.2:8081
NoDelay=true
Accept=false

[Install]
WantedBy=wg-quick@wg0.service
