[Unit]
Description=ProofOfWork PostgreSQL logical backup
Requires=postgresql@16-main.service
After=postgresql@16-main.service
RequiresMountsFor=/data/proofofwork-postgres-backups

[Service]
Type=oneshot
User=postgres
Group=postgres
UMask=0077
ExecStart=/usr/local/sbin/proofofwork-postgres-logical-backup
# Observed Oct 1 peak: 20,333,518,848 bytes. These limits retain headroom
# while preventing an unbounded dump from competing with canonical services.
TimeoutStartSec=90m
TimeoutStopSec=30s
KillMode=control-group
MemoryHigh=24G
MemoryMax=32G
CPUQuota=200%
TasksMax=32
IOWeight=10
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/proofofwork-postgres-backups/logical
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
