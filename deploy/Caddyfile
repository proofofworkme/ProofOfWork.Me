(common_api_proxy) {
	handle /api/* {
		reverse_proxy http://10.77.0.2:8081 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle /health* {
		reverse_proxy http://10.77.0.2:8081 {
			header_up X-Forwarded-For {remote_host}
		}
	}
}

(common_static_policy) {
	encode zstd gzip
	import common_headers
	import common_api_proxy
	@immutable path_regexp immutable ^/assets/.*-[A-Za-z0-9_-]{8,}\..+$
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@document {
		not path /assets/* /api/* /health*
	}
	header @document Cache-Control "no-cache, must-revalidate"
}

# Only real application documents may use a shell. Missing assets and unknown
# paths keep file_server's HTTP 404 instead of becoming an indexable SPA page.
# Public query keys mirror src/app/seoMetadata.mjs; everything else is private
# or a search/filter state until the application can qualify it.
(seo_document) {
	route {
		handle @seo_private_query {
			header X-Robots-Tag "noindex, nofollow"
			rewrite * /noindex-app.html
			file_server
		}
		handle @seo_publish_article {
			import publish_render_proxy
		}
		handle @seo_any_query {
			rewrite * /app.html
			file_server
		}
		handle {
			rewrite * {args.0}
			file_server
		}
	}
}

(publish_render_proxy) {
	header {
		defer
		Cache-Control "no-store"
	}
	reverse_proxy http://127.0.0.1:8084 {
		transport http {
			dial_timeout 2s
			response_header_timeout 55s
		}
	}
}

(seo_static_routes) {
	@seo_private_query not expression `({http.request.uri.query} == "" ||
		{http.request.uri.query}.matches("^(?:network=livenet|(?i:utm_[a-z0-9_]+|gclid|fbclid|msclkid)=[^&]*)(?:&(?:network=livenet|(?i:utm_[a-z0-9_]+|gclid|fbclid|msclkid)=[^&]*))*$") ||
		({http.request.host} == "publish.proofofwork.me" && {http.request.uri.query}.matches("^(?:network=livenet|(?i:utm_[a-z0-9_]+|gclid|fbclid|msclkid)=[^&]*|article=[0-9a-fA-F]{64}|profile=[^&]{1,1000})(?:&(?:network=livenet|(?i:utm_[a-z0-9_]+|gclid|fbclid|msclkid)=[^&]*|article=[0-9a-fA-F]{64}|profile=[^&]{1,1000}))*$")) ||
		({http.request.host} == "boost.proofofwork.me" && {http.request.uri.query}.matches("^(?:network=livenet|(?i:utm_[a-z0-9_]+|gclid|fbclid|msclkid)=[^&]*|profile=[^&]{1,1000})(?:&(?:network=livenet|(?i:utm_[a-z0-9_]+|gclid|fbclid|msclkid)=[^&]*|profile=[^&]{1,1000}))*$")) ||
		({http.request.host} == "code.proofofwork.me" && {http.request.uri.query}.matches("(^|&)repo=[0-9a-fA-F]{64}(&|$)") && {http.request.uri.query}.matches("^(?:network=livenet|(?i:utm_[a-z0-9_]+|gclid|fbclid|msclkid)=[^&]*|(?:repo|version)=[0-9a-fA-F]{64}|path=[^&]+)(?:&(?:network=livenet|(?i:utm_[a-z0-9_]+|gclid|fbclid|msclkid)=[^&]*|(?:repo|version)=[0-9a-fA-F]{64}|path=[^&]+))*$")) ||
		({http.request.host} == "jobs.proofofwork.me" && {http.request.uri.query}.matches("^(?:network=livenet|(?i:utm_[a-z0-9_]+|gclid|fbclid|msclkid)=[^&]*|job=[0-9a-fA-F]{64})(?:&(?:network=livenet|(?i:utm_[a-z0-9_]+|gclid|fbclid|msclkid)=[^&]*|job=[0-9a-fA-F]{64}))*$")) ||
		({http.request.host} == "browser.proofofwork.me" && {http.request.uri.query}.matches("^(?:network=livenet|(?i:utm_[a-z0-9_]+|gclid|fbclid|msclkid)=[^&]*|(?:txid|tx)=[0-9a-fA-F]{64}|name=[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:[.][a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)?[.](?i:pow))(?:&(?:network=livenet|(?i:utm_[a-z0-9_]+|gclid|fbclid|msclkid)=[^&]*|(?:txid|tx)=[0-9a-fA-F]{64}|name=[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:[.][a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)?[.](?i:pow)))*$")) ||
		({http.request.host} == "credit.proofofwork.me" && {http.request.uri.query}.matches("^(?:network=livenet|(?i:utm_[a-z0-9_]+|gclid|fbclid|msclkid)=[^&]*|asset=[0-9a-fA-F]{64})(?:&(?:network=livenet|(?i:utm_[a-z0-9_]+|gclid|fbclid|msclkid)=[^&]*|asset=[0-9a-fA-F]{64}))*$")))
		&& !({http.request.host} == "publish.proofofwork.me" && {http.request.uri.query}.matches("(^|&)(?:article|profile)=[^&]*(?:&[^&]*)*&(?:article|profile)="))
		&& !({http.request.host} == "browser.proofofwork.me" && {http.request.uri.query}.matches("(^|&)(?:txid|tx|name)=[^&]*(?:&[^&]*)*&(?:txid|tx|name)="))
		&& !{http.request.uri.query}.matches("(^|&)(?:network=[^&]*(?:&[^&]*)*&network=|article=[^&]*(?:&[^&]*)*&article=|profile=[^&]*(?:&[^&]*)*&profile=|repo=[^&]*(?:&[^&]*)*&repo=|version=[^&]*(?:&[^&]*)*&version=|path=[^&]*(?:&[^&]*)*&path=|job=[^&]*(?:&[^&]*)*&job=|txid=[^&]*(?:&[^&]*)*&txid=|tx=[^&]*(?:&[^&]*)*&tx=|name=[^&]*(?:&[^&]*)*&name=|asset=[^&]*(?:&[^&]*)*&asset=)")`
	@seo_any_query expression `{http.request.uri.query} != ""`
	@seo_publish_article {
		host publish.proofofwork.me
		path / /index.html
		expression `{http.request.uri.query}.matches("(^|&)article=[0-9a-fA-F]{64}(&|$)")`
	}
	@seo_publish_reader {
		host publish.proofofwork.me
		path /articles /articles/ /articles-sitemap.xml /publish-render-provenance.json
	}
	@seo_internal_documents path /app.html /noindex-app.html /404.html
	@seo_runner path /pages-runner.html
	@seo_publish_writer {
		host publish.proofofwork.me
		path /write /write/
	}
	@seo_browser_reader {
		host browser.proofofwork.me
		path_regexp seo_browser_reader (?i)^/(?:(?:tx/)?[0-9a-f]{64}|(?:name/)?[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(?:[.][a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)?[.](?i:pow))/?$
	}
	@seo_root path / /index.html
	route {
		header @seo_runner X-Robots-Tag "noindex, nofollow"
		handle @seo_publish_reader {
			import publish_render_proxy
		}
		handle @seo_internal_documents {
			header X-Robots-Tag "noindex, nofollow"
			file_server
		}
		handle @seo_publish_writer {
			header X-Robots-Tag "noindex, nofollow"
			rewrite * /noindex-app.html
			file_server
		}
		handle @seo_browser_reader {
			import seo_document /app.html
		}
		handle @seo_root {
			import seo_document /index.html
		}
		file_server
	}
}

