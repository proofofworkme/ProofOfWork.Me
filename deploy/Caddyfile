{
	admin 127.0.0.1:2019
	log default {
		exclude http.log.access
	}
	log ui_access {
		include http.log.access
		output file /var/log/caddy/access.json {
			mode 0600
			roll_size 25MiB
			roll_interval 24h
			roll_keep 8
			roll_keep_for 168h
		}
		format filter {
			fields {
				request>client_ip delete
				request>remote_ip delete
				request>remote_port delete
				request>headers delete
				request>uri regexp \?.*$ ""
				resp_headers delete
			}
			wrap json
		}
	}
}

(common_access_log) {
	log
}

(common_headers) {
	import common_access_log
	@parent_document not path /pages-runner.html
	header @parent_document {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.proofofwork.me wss://*.proofofwork.me; frame-src 'self'; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	}
	@socialIdentityParents {
		host code.proofofwork.me
		not path /pages-runner.html
	}
	header @socialIdentityParents {
		defer
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.proofofwork.me wss://*.proofofwork.me; frame-src 'self' https://computer.proofofwork.me; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
	}
	@socialVideoParents {
		host boost.proofofwork.me publish.proofofwork.me
		not path /pages-runner.html
	}
	header @socialVideoParents {
		defer
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.proofofwork.me wss://*.proofofwork.me; frame-src 'self' https://computer.proofofwork.me https://www.youtube-nocookie.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
	}
	@computerVideoParent {
		host computer.proofofwork.me
		not path /pages-runner.html
		not {
			path /
			expression `{http.request.uri.query} == "social-identity-bridge=1"`
		}
	}
	header @computerVideoParent {
		defer
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.proofofwork.me wss://*.proofofwork.me; frame-src 'self' https://www.youtube-nocookie.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
	}
	@socialIdentityBridge {
		host computer.proofofwork.me
		path /
		expression `{http.request.uri.query} == "social-identity-bridge=1"`
	}
	header @socialIdentityBridge {
		defer
		-X-Frame-Options
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors https://boost.proofofwork.me https://publish.proofofwork.me https://code.proofofwork.me https://computer.proofofwork.me; form-action 'none'; script-src 'self'; style-src 'self'; img-src 'none'; media-src 'none'; font-src 'self'; connect-src 'self'; frame-src 'none'; worker-src 'none'; manifest-src 'none'; upgrade-insecure-requests"
	}
	import pages_runner_headers
}

