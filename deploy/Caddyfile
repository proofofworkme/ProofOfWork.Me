{
	admin 127.0.0.1:2019
	log default {
		exclude http.log.access
	}
	log ui_access {
		include http.log.access http.log.error
		output file /var/log/caddy/access.json {
			mode 0600
			roll_size 25MiB
			roll_interval 24h
			roll_keep 8
			roll_keep_for 168h
		}
		format filter {
			fields {
				request>client_ip delete
				request>remote_ip delete
				request>remote_port delete
				request>headers delete
				request>uri regexp \?.*$ ""
				resp_headers delete
			}
			wrap json
		}
	}
}

(common_access_log) {
	log
}

(common_headers) {
	import common_access_log
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.proofofwork.me wss://*.proofofwork.me; frame-src 'self'; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	}
}

(landing_headers) {
	import common_access_log
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.proofofwork.me wss://*.proofofwork.me; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	}
}

(common_api_proxy) {
	handle /api/* {
		reverse_proxy http://10.77.0.2:8081 {
			header_up X-Forwarded-For {remote_host}
			health_uri /health/live
			health_interval 30s
			health_timeout 5s
			health_status 200
			lb_try_duration 5s
			lb_try_interval 250ms
		}
	}
	handle /health* {
		reverse_proxy http://10.77.0.2:8081 {
			header_up X-Forwarded-For {remote_host}
			health_uri /health/live
			health_interval 30s
			health_timeout 5s
			health_status 200
			lb_try_duration 5s
			lb_try_interval 250ms
		}
	}
}

(common_static_policy) {
	encode zstd gzip
	import common_headers
	import common_api_proxy
	@immutable path_regexp immutable ^/assets/.*-[A-Za-z0-9_-]{8,}\..+$
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@document {
		not path /assets/* /api/* /health*
	}
	header @document Cache-Control "no-cache, must-revalidate"
}

(common_landing_app) {
	encode zstd gzip
	import landing_headers
	import common_api_proxy
	@immutable path_regexp immutable ^/assets/.*-[A-Za-z0-9_-]{8,}\..+$
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@document {
		not path /assets/* /api/* /health*
	}
	header @document Cache-Control "no-cache, must-revalidate"
	handle {
		root * /var/www/proofofwork-landing
		try_files {path} /index.html
		file_server
	}
}

