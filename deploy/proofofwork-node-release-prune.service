[Unit]
Description=Prune managed ProofOfWork node release backups
RequiresMountsFor=/data/proofofwork-release-backups

[Service]
Type=oneshot
# Node archive deletion awaits a separate exact retention approval.
ExecStart=/usr/local/sbin/proofofwork-release-prune /data/proofofwork-release-backups/managed 3 --dry-run
TimeoutStartSec=30m
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ReadWritePaths=/data/proofofwork-release-backups/managed
# Read private runtime-owned Git metadata; retain all existing private modes.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077
Nice=10
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
