[Unit]
Description=Prune managed ProofOfWork node release backups
RequiresMountsFor=/data/proofofwork-release-backups
OnFailure=proofofwork-ops-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/proofofwork-release-prune /data/proofofwork-release-backups/managed 3
TimeoutStartSec=30m
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ReadWritePaths=/data/proofofwork-release-backups/managed
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
UMask=0077
Nice=10
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
