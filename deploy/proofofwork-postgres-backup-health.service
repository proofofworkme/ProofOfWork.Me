[Unit]
Description=Check ProofOfWork PostgreSQL logical, physical, WAL, and off-site backup health
Requisite=postgresql@16-main.service
After=postgresql@16-main.service
RequiresMountsFor=/data/proofofwork-postgres-backups
OnFailure=proofofwork-ops-alert@%n.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/usr/local/sbin/proofofwork-postgres-backup-health
StateDirectory=proofofwork-backup-health
StateDirectoryMode=0750
TimeoutStartSec=10m
Nice=10
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
UMask=0077
