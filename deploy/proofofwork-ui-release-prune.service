[Unit]
Description=Inspect managed ProofOfWork UI release backup retention

[Service]
Type=oneshot
# Existing archives require exact deletion approval; scheduled checks only report.
ExecStart=/usr/local/sbin/proofofwork-release-prune /var/backups/proofofwork-ui/releases 5 --dry-run
TimeoutStartSec=30m
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ReadWritePaths=/var/backups/proofofwork-ui/releases /run/proofofwork-ui
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077
Nice=10
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
