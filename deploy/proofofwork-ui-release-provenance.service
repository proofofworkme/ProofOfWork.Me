[Unit]
Description=Verify active ProofOfWork UI release provenance

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/proofofwork-ui-release-provenance verify-rollback
TimeoutStartSec=30m
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ReadWritePaths=/run/proofofwork-ui
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
Nice=10
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
