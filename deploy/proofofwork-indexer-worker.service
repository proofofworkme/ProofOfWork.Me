[Unit]
Description=ProofOfWork.Me PostgreSQL event indexer worker
After=network-online.target postgresql@16-main.service proofofwork-api.service
Wants=network-online.target proofofwork-api.service
Requires=postgresql@16-main.service
PartOf=postgresql@16-main.service proofofwork-api.service

[Service]
Type=simple
User=powadmin
WorkingDirectory=/opt/proofofwork-api
EnvironmentFile=/etc/proofofwork-api/proof-indexer-db.env
EnvironmentFile=-/etc/proofofwork-api/bitcoin-rpc.env
EnvironmentFile=/etc/proofofwork-api/internal-verifier.env
Environment=NETWORK=livenet
Environment=POW_INDEX_REQUIRE_WORK_ATOMS=1
# The superseded V7 proposal remains explicitly empty and disabled.
Environment=WORK_AMO_V7_DECLARATION_TXID=
Environment=WORK_AMO_V7_DECLARATION_HEIGHT=
Environment=WORK_AMO_V7_DECLARATION_BLOCK_HASH=
Environment=WORK_AMO_V7_DECLARATION_BLOCK_INDEX=
Environment=WORK_AMO_V7_DECLARATION_MEMO_SHA256=
Environment=WORK_AMO_V7_DECLARATION_MEMO_BYTES=
Environment=WORK_AMO_V7_DECLARATION_PROTOCOL_VOUT=
Environment=WORK_AMO_V7_DECLARATION_RECORD_ORDINAL=
Environment=WORK_AMO_V7_DECLARATION_REGISTRY_PAYMENT_VOUT=
Environment=WORK_AMO_V7_ACTIVATION_HEIGHT=
Environment=WORK_AMO_V7_WRITES_ENABLED=0
# AMO V8/Q16 declaration pins are canonical and complete. The deployment write
# gate is open; the worker remains fail-closed until migration and replay pass.
Environment=WORK_AMO_V8_DECLARATION_TXID=f90e1faf572ef8253ca5959731b9d9e99c74bced4397380059878936712bee7a
Environment=WORK_AMO_V8_DECLARATION_HEIGHT=960600
Environment=WORK_AMO_V8_DECLARATION_BLOCK_HASH=00000000000000000001ec938998cde4fd86ee6e3c672a6d3d95200cd8a984ac
Environment=WORK_AMO_V8_DECLARATION_BLOCK_INDEX=2369
Environment=WORK_AMO_V8_DECLARATION_MEMO_SHA256=1ba53b285f95f8d69f0272c8e75c76b09cd3bd26281c68e665749368e7694528
Environment=WORK_AMO_V8_DECLARATION_MEMO_BYTES=5593
Environment=WORK_AMO_V8_DECLARATION_PROTOCOL_VOUT=3
Environment=WORK_AMO_V8_DECLARATION_RECORD_ORDINAL=0
Environment=WORK_AMO_V8_DECLARATION_REGISTRY_PAYMENT_VOUT=4
Environment=WORK_AMO_V8_ACTIVATION_HEIGHT=960601
Environment=WORK_AMO_V8_WRITES_ENABLED=1
Environment=POW_API_BASE=http://127.0.0.1:8081
Environment=POW_INDEX_WORKER_INTERVAL_MS=30000
Environment=POW_INDEX_WORKER_PENDING_WITNESS_MAX_AGE_MS=600000
Environment=POW_INDEX_WORKER_BACKFILL_MAX_PAGES=20
Environment=POW_INDEX_WORKER_BACKFILL_SOURCES=block-scan,mempool-scan
Environment=POW_INDEX_WORKER_BACKFILL_SOURCE_FRESH=0
Environment=POW_INDEX_WORKER_BACKFILL_SUMMARY_SNAPSHOT_FRESH=0
Environment=POW_INDEX_WORKER_BACKFILL_TOKEN_SNAPSHOT_FRESH=0
Environment=POW_INDEX_WORKER_BACKFILL_STORE_LEDGER_SNAPSHOT=0
Environment=POW_INDEX_WORKER_BACKFILL_STORE_CANONICAL_SUMMARY_SNAPSHOT=1
Environment=POW_INDEX_CANONICAL_SUMMARY_REFRESH_TIMEOUT_MS=600000
Environment=POW_INDEX_BACKFILL_BLOCK_SCAN_MAX_BLOCKS=250
Environment=POW_INDEX_BACKFILL_BLOCK_SCAN_MAX_TXIDS=250
Environment=POW_INDEX_BITCOIN_RPC_TIMEOUT_MS=15000
Environment=POW_INDEX_BITCOIN_RPC_RETRIES=2
Environment=POW_INDEX_PREVOUT_HYDRATION_CONCURRENCY=4
Environment=ELECTRUM_HOST=172.27.0.1
Environment=ELECTRUM_PORT=50001
Environment=POW_INDEX_MEMPOOL_SCAN_MAX_TXIDS=500
Environment=POW_INDEX_MEMPOOL_SCAN_MAX_PROTOCOL_TXIDS=5
Environment=POW_INDEX_MEMPOOL_SCAN_BUDGET_MS=30000
Environment=POW_INDEX_PENDING_VERIFIER_TIMEOUT_MS=30000
Environment=POW_INDEX_WORKER_HOLDERS=0
Environment=POW_INDEX_WORKER_PARITY=0
Environment=POW_INDEX_WORKER_PARITY_INTERVAL_MS=900000
Environment=POW_INDEX_PENDING_MIN_AGE_MS=60000
Environment=POW_INDEX_PENDING_STATUS_LIMIT=64
Environment=POW_INDEX_PENDING_STATUS_BUDGET_MS=15000
Environment=POW_INDEX_PENDING_STATUS_CONCURRENCY=5
Environment=POW_INDEX_FETCH_TIMEOUT_MS=180000
Environment=POW_INDEX_STATUS_FETCH_TIMEOUT_MS=5000
Environment=POW_INDEX_FETCH_RETRIES=8
Environment=POW_INDEX_WORKER_BACKFILL_TIMEOUT_MS=900000
Environment=POW_INDEX_WORKER_PENDING_BACKFILL_TIMEOUT_MS=600000
Environment=POW_INDEX_WORKER_PARITY_TIMEOUT_MS=120000
Environment=POW_INDEX_WORKER_MAX_CONSECUTIVE_FAILURES=3
Environment=POW_INDEX_WORKER_ERROR_INTERVAL_MS=60000
Environment=POW_INDEX_WORKER_MAX_ERROR_INTERVAL_MS=900000
Environment=POW_INDEX_WORKER_NO_PROGRESS_ALERT_INTERVAL_MS=900000
ExecStartPre=/usr/bin/pg_isready --quiet --host=127.0.0.1 --port=5432 --dbname=proof_indexer
ExecStart=/opt/node-v24.18.0-linux-x64/bin/node /opt/proofofwork-api/scripts/run-proof-indexer-worker.mjs --loop
Restart=always
RestartSec=15
TimeoutStopSec=30
KillMode=control-group
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=full
ProtectHome=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=multi-user.target
WantedBy=postgresql@16-main.service
