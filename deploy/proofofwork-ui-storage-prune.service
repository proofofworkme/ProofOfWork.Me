[Unit]
Description=Prune bounded ProofOfWork UI deployment scratch

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/proofofwork-ui-storage-prune --apply
TimeoutStartSec=30m
NoNewPrivileges=true
PrivateTmp=false
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ReadWritePaths=/var/www /var/tmp
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077
Nice=10
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
