[Unit]
Description=Verify ProofOfWork node release provenance and archive coverage
RequiresMountsFor=/data/proofofwork-release-backups
OnFailure=proofofwork-ops-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/proofofwork-node-release-health
Environment=POW_RELEASE_MAX_CHECKOUT_COUNT=9
Nice=10
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
TimeoutStartSec=30m
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
# The live checkout is intentionally powadmin-private while managed release
# archives are root-private. Grant root only the read/traverse capability Git
# needs to inspect the former; no write or ownership capability is added.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
